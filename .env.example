# SatsGate Environment Variables

# SMTP Configuration for Email Sending (Production)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL="Emmanuel from SatsGate" <hello@satsgate.com>
ADMIN_SECRET=super-secret-key-123

# Alternative SMTP Providers (choose one):
# Brevo (300 emails/day free): smtp-relay.brevo.com:587
# SMTP2GO (1000 emails/month free): mail.smtp2go.com:587
# SendPulse (12000 emails/month free): smtp-pulse.com:587
# Gmail (for testing): smtp.gmail.com:587 (use App Password)

# Development settings
VITE_NODE_ENV=development