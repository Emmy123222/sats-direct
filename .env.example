# SatsGate Environment Variables

# Waitlist API endpoint (optional - if not set, uses localStorage only)
# VITE_WAITLIST_API=https://your-api.com/waitlist

# Email Configuration - Choose ONE provider

# 1. RESEND (Recommended - Modern, developer-friendly)
# Get API key from https://resend.com/
VITE_RESEND_API_KEY=re_xxxxxxxxxx

# 2. SENDGRID (Enterprise standard)
# Get API key from https://sendgrid.com/
# VITE_SENDGRID_API_KEY=SG.xxxxxxxxxx

# 3. MAILGUN (Developer favorite)
# Get API key from https://mailgun.com/
# VITE_MAILGUN_API_KEY=key-xxxxxxxxxx
# VITE_MAILGUN_DOMAIN=mg.yourdomain.com

# 4. POSTMARK (Transactional focus)
# Get API key from https://postmarkapp.com/
# VITE_POSTMARK_API_KEY=xxxxxxxxxx

# 5. AMAZON SES (AWS integration - requires backend)
# VITE_AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXX
# VITE_AWS_SECRET_ACCESS_KEY=xxxxxxxxxx
# VITE_AWS_REGION=us-east-1

# Email sender details
VITE_FROM_EMAIL=hello@satsgate.com
VITE_FROM_NAME=SatsGate Team

# Custom email API endpoint (if using your own backend)
# VITE_EMAIL_API_ENDPOINT=https://your-api.com/send-email

# Analytics tracking (optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Admin password (change this!)
# VITE_ADMIN_PASSWORD=your-secure-password

# Development settings
VITE_NODE_ENV=development