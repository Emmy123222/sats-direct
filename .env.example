# SatsGate Environment Variables

# Email Configuration - REQUIRED for sending welcome emails to users
# Brevo (formerly Sendinblue) - 300 emails/day free
# Get your free API key from https://app.brevo.com
VITE_BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx

# Email sender details
VITE_FROM_EMAIL=noreply@satsgate.com
VITE_FROM_NAME=Emmanuel from SatsGate

# Alternative email providers (if you want to switch later)
# VITE_RESEND_API_KEY=re_xxxxxxxxxx
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Waitlist API endpoint (optional - if not set, uses localStorage only)
# VITE_WAITLIST_API=https://your-api.com/waitlist

# Analytics tracking (optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Admin password (change this!)
# VITE_ADMIN_PASSWORD=your-secure-password

# Development settings
VITE_NODE_ENV=development